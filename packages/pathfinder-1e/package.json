{
  "name": "@lippelt/srd-pathfinder-1e",
  "version": "1.0.0",
  "description": "Pathfinder 1e system module for @lippelt/srd-core — PRD, OGL 1.0a (Paizo)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.d.ts",
    "dist/index.d.cts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/copy-license.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flippelt/gmcr-srd-systems.git",
    "directory": "packages/pathfinder-1e"
  },
  "peerDependencies": {
    "@lippelt/srd-core": "^1.0.0"
  },
  "devDependencies": {
    "@lippelt/srd-core": "*"
  },
  "sideEffects": false,
  "homepage": "https://github.com/flippelt/gmcr-srd-systems/tree/main/packages/pathfinder-1e",
  "bugs": {
    "url": "https://github.com/flippelt/gmcr-srd-systems/issues"
  }
}
